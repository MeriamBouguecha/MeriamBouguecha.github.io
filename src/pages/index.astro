                    <p>{project.description}</p>
                    {project.result && <p class="result">{project.result}</p>}
                    {project.link && (
                      <a class="card-link" href={project.link.href} target="_blank" rel="noopener noreferrer">{project.link.label}</a>
                    )}
                    <div class="tags">
                      {project.tags.map((tag) => <span class="tag">{tag}</span>)}
                    </div>
